<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
     https://material.io/develop/android/theming/dark
    -->

    <!-- TermuxActivity DayNight NoActionBar theme with Material You dark style. -->
    <style name="Theme.TermuxActivity.DayNight.NoActionBar" parent="Theme.TermuxApp.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/m3_dark_primary</item>
        <item name="colorPrimaryVariant">@color/m3_dark_primary_container</item>
        <item name="colorSecondary">@color/m3_dark_secondary</item>
        <item name="colorSurface">@color/m3_dark_surface</item>
        <item name="colorOnSurface">@color/m3_dark_on_surface</item>

        <item name="android:windowBackground">@color/black</item>

        <!-- Avoid action mode toolbar pushing down terminal content when
             selecting text on pre-6.0 (non-floating toolbar). -->
        <item name="android:windowActionModeOverlay">true</item>

        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>

        <!-- https://developer.android.com/training/tv/start/start.html#transition-color -->
        <item name="android:windowAllowReturnTransitionOverlap">true</item>
        <item name="android:windowAllowEnterTransitionOverlap">true</item>

        <!-- Left drawer. -->
        <item name="buttonBarButtonStyle">@style/TermuxActivity.Drawer.ButtonBarStyle.Dark</item>
        <item name="termuxActivityDrawerBackground">@color/m3_dark_surface_container</item>
        <item name="termuxActivityDrawerImageTint">@color/m3_dark_on_surface</item>

        <!-- Extra keys colors. -->
        <item name="extraKeysButtonTextColor">@color/white</item>
        <item name="extraKeysButtonActiveTextColor">@color/red_400</item>
        <item name="extraKeysButtonBackgroundColor">@color/black</item>
        <item name="extraKeysButtonActiveBackgroundColor">@color/grey_500</item>
    </style>

    <!-- Theme for Material You Storage File Manager -->
    <style name="Theme.TermuxStorageActivity" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/m3_dark_primary</item>
        <item name="colorPrimaryVariant">@color/m3_dark_primary_container</item>
        <item name="colorSecondary">@color/m3_dark_secondary</item>
        <item name="colorSurface">@color/m3_dark_surface</item>
        <item name="colorOnSurface">@color/m3_dark_on_surface</item>
        <item name="android:windowBackground">@color/m3_dark_background</item>
        <item name="android:statusBarColor">@color/m3_dark_surface_container</item>
        <item name="android:navigationBarColor">@color/m3_dark_surface_container</item>
    </style>

</resources>
